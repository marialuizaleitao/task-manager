# Copie este arquivo para ".env" e ajuste os valores conforme o ambiente.
# Nunca versione o arquivo ".env" real.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=task_manager
POSTGRES_USER=task_manager
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api

# ---------------------------------------------------------------------------
# Integração: Google Calendar
# ---------------------------------------------------------------------------
# Credenciais do OAuth Client (tipo "Aplicativo da Web") criado no Google
# Cloud Console. Ver README > "Configurar o Google Cloud" para o passo a
# passo completo, incluindo por que o app permanece em modo Testing.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google-calendar/callback/

# Chave Fernet para cifrar tokens OAuth em repouso. Gere uma com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# URL do frontend para onde o navegador é redirecionado ao final do fluxo OAuth.
FRONTEND_BASE_URL=http://localhost:5173
