# Copie este arquivo para ".env" na instância EC2 e ajuste os valores reais.
# Nunca versione o arquivo ".env" real. Ver docs/deploy-aws.md para o passo
# a passo completo de deploy.
#
# Este arquivo documenta apenas o que muda ou se soma em relação ao
# .env.example de desenvolvimento — a lista completa de variáveis de
# integração (Google Calendar, Telegram) é a mesma nos dois ambientes.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=gere-uma-chave-forte-e-unica-aqui
DJANGO_DEBUG=False

# Domínio real da aplicação (sem protocolo). Usado pelo Django e também
# interpolado no template do Nginx (docker/nginx/nginx.conf.template).
DOMAIN_NAME=task-manager-maria.duckdns.org
DJANGO_ALLOWED_HOSTS=task-manager-maria.duckdns.org

# Necessário para o Django aceitar POSTs vindos do próprio domínio em HTTPS
# em qualquer view autenticada por sessão (a API em si usa JWT, sem CSRF).
DJANGO_CSRF_TRUSTED_ORIGINS=https://task-manager-maria.duckdns.org

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Em produção o Nginx serve o React e faz proxy da API na mesma origem
# (mesmo domínio, mesma porta) — não há requisição cross-origin do
# navegador, então nenhuma origem precisa ser liberada aqui.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=task_manager
POSTGRES_USER=task_manager
POSTGRES_PASSWORD=gere-uma-senha-forte-aqui
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Caminho relativo: já é embutido no build da imagem (ver frontend/Dockerfile,
# ARG VITE_API_URL). Não precisa ser definido aqui — documentado para
# referência.
# VITE_API_URL=/api

# ---------------------------------------------------------------------------
# Gunicorn (backend/docker-entrypoint.prod.sh)
# ---------------------------------------------------------------------------
# Ajustados para uma instância t3.micro (1 vCPU / 1 GiB RAM). Workers =
# 2 * vCPU + 1 é a fórmula usual, mas nesse porte de instância isso
# competiria por memória com Postgres e Nginx — 2 workers é o equilíbrio
# adotado. Aumente apenas se migrar para uma instância maior.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# ---------------------------------------------------------------------------
# Integração: Google Calendar
# ---------------------------------------------------------------------------
# Mesmas variáveis do .env.example — só os valores de URL mudam para o
# domínio de produção:
# GOOGLE_OAUTH_REDIRECT_URI=https://task-manager-maria.duckdns.org/api/integrations/google-calendar/callback/
# FRONTEND_BASE_URL=https://task-manager-maria.duckdns.org
