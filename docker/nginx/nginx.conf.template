# Gateway único de produção: TLS termination + serve o build do React +
# proxy para o Gunicorn (API). Renderizado a partir deste template
# pelo entrypoint padrão da imagem nginx:alpine (envsubst em
# /etc/nginx/templates/*.template), que substitui apenas as variáveis de
# ambiente definidas no container — por isso só ${DOMAIN_NAME} é
# interpolado; toda variável nativa do Nginx (ex.: $host, $remote_addr)
# permanece intacta.

# Bloco HTTP: mantém o desafio ACME do Certbot sempre acessível (necessário
# também nas renovações, não só na emissão inicial) e redireciona todo o
# resto para HTTPS.
server {
    listen 80;
    server_name ${DOMAIN_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Cabeçalhos de segurança. HSTS também é reforçado pelo Django
    # (config/settings/prod.py) — mantê-lo aqui é defesa em profundidade,
    # não depende de nenhuma requisição chegar até o backend.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Limite de upload da API. Nenhum endpoint hoje aceita arquivos grandes;
    # 10m é uma folga confortável sem deixar o valor irrestrito.
    client_max_body_size 10m;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    root /usr/share/nginx/html;
    index index.html;

    # Arquivos estáticos coletados pelo Django (ex.: browsable API do DRF) —
    # servidos direto pelo Nginx, sem passar pelo Gunicorn.
    location /static/ {
        alias /usr/share/nginx/html/backend-static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Bundle do React: hashes no nome do arquivo permitem cache agressivo.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://backend:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # SPA: qualquer rota não resolvida cai no index.html (roteamento client-side).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
